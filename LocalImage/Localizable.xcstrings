    "%@ свободно" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ free"
          }
        }
      }
    },
    "%@, %lld ГБ объединённой памяти%@.\n\nДвижок: mflux %@ на MLX %@ — нативный фреймворк Apple для машинного обучения на Apple Silicon. Модели работают полностью локально, ничего не уходит в сеть.\n\nДоступно GPU без подкачки: %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$lld GB unified memory%3$@.\n\nEngine: mflux %4$@ on MLX %5$@, Apple's native machine learning framework for Apple Silicon. Models run entirely on this Mac; nothing is sent over the network.\n\nGPU memory available without swapping: %6$@."
          }
        }
      }
    },
    "%@: пик ≈ %@ из %@ доступных GPU" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: peak ≈ %2$@ of %3$@ available to the GPU"
          }
        }
      }
    },
